generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  ORGANIZATION
  CARE_SEEKER
}

enum ModuleKey {
  DASHBOARD
  USERS
  ROLES
  MODULES
  ORGANIZATIONS
  CARE_SEEKERS
  CASES
  MESSAGES
  INCIDENTS
  SAFETY_LOGS
  EVIDENCE
  RAG_DOCUMENTS
  AUDIT_LOGS
  SYSTEM_SETTINGS
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
}

enum OrganizationType {
  NGO
  GOVERNMENT
  ERT
  HEALTHCARE
  LEGAL
  POLICE
  SHELTER
  SYSTEM
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  USER_LOGIN
  CASE_VIEWED
  CASE_CREATED
  CASE_UPDATED
  CARE_SEEKER_VIEWED
  CARE_SEEKER_UPDATED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ROLE_CHANGED
  MODULE_TOGGLED
  PERMISSIONS_UPDATED
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  passwordHash   String
  fullName       String     @map("name")
  phone          String?
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  roles          UserRole[]
  casesCreated   Case[]        @relation("CaseCreatedBy")
  casesAssigned  Case[]        @relation("CaseAssignedTo")
  auditLogs      AuditLog[]     @relation("ActorAuditLogs")
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model AppModule {
  id          String           @id @default(uuid()) @db.Uuid
  key         ModuleKey        @unique
  name        String
  description String?
  isEnabled   Boolean          @default(true)
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        String    @id @default(uuid()) @db.Uuid
  roleId    String    @db.Uuid
  moduleId  String    @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canView   Boolean   @default(false)
  canCreate Boolean   @default(false)
  canUpdate Boolean   @default(false)
  canDelete Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roleId, moduleId])
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  type        OrganizationType
  phone       String?
  address     String?
  users       User[]
  careSeekers CareSeeker[]
  cases       Case[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
}

model CareSeeker {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  fullName       String     @map("name")
  phone          String?
  address        String?
  riskLevel      RiskLevel     @default(MEDIUM)
  safetyNotes    String?
  cases          Case[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
}

model Case {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String?       @db.Uuid
  careSeekerId        String        @db.Uuid
  createdById         String?       @db.Uuid
  assignedToId        String?       @db.Uuid
  title               String
  summary             String?
  notes               String?
  incidentDescription String?
  status              CaseStatus    @default(OPEN)
  riskLevel           RiskLevel     @default(MEDIUM)
  organization        Organization? @relation(fields: [organizationId], references: [id])
  careSeeker          CareSeeker    @relation(fields: [careSeekerId], references: [id])
  createdBy           User?         @relation("CaseCreatedBy", fields: [createdById], references: [id])
  assignedTo          User?         @relation("CaseAssignedTo", fields: [assignedToId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  actor       User?       @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  createdAt   DateTime    @default(now())
}
