generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  ORGANIZATION
  CARE_SEEKER
}

enum ModuleKey {
  DASHBOARD
  USERS
  ROLES
  MODULES
  ORGANIZATIONS
  CARE_SEEKERS
  CASES
  MESSAGES
  INCIDENTS
  SAFETY_LOGS
  EVIDENCE
  RAG_DOCUMENTS
  AUDIT_LOGS
  SYSTEM_SETTINGS
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
}

enum OrganizationType {
  NGO
  GOVERNMENT
  ERT
  HEALTHCARE
  LEGAL
  POLICE
  SHELTER
  SYSTEM
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CareSeekerSource {
  WHATSAPP
  WEB
  ADMIN
}

enum CareSeekerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ConversationChannel {
  WHATSAPP
  WEB
}

enum ConversationSessionStatus {
  ACTIVE
  CLOSED
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum ConversationMessageType {
  TEXT
  IMAGE
}

enum IncidentSource {
  WHATSAPP
  WEB
  ADMIN
}

enum IncidentCategory {
  DOMESTIC_VIOLENCE
  PHYSICAL_ABUSE
  EMOTIONAL_ABUSE
  SEXUAL_ABUSE
  FINANCIAL_ABUSE
  STALKING
  HARASSMENT
  THREAT
  OTHER
  UNKNOWN
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

enum IncidentUrgency {
  LOW
  SOON
  URGENT
  IMMEDIATE
  UNKNOWN
}

enum IncidentStatus {
  DRAFT
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum EvidenceSource {
  WHATSAPP
  WEB
  ADMIN
  ADMIN_UPLOAD
  AI_SERVICE
}

enum EvidenceType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEXT
}

enum EvidenceAiAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EvidenceUploadedBy {
  CARE_SEEKER
  ADMIN
  AI_SERVICE
}

enum EvidenceStatus {
  ACTIVE
  DELETED
}

enum AuditAction {
  USER_LOGIN
  CASE_VIEWED
  CASE_CREATED
  CASE_UPDATED
  CARE_SEEKER_VIEWED
  CARE_SEEKER_UPDATED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ROLE_CHANGED
  MODULE_TOGGLED
  PERMISSIONS_UPDATED
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  passwordHash   String
  fullName       String     @map("name")
  phone          String?
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  roles          UserRole[]
  casesCreated   Case[]        @relation("CaseCreatedBy")
  casesAssigned  Case[]        @relation("CaseAssignedTo")
  auditLogs      AuditLog[]     @relation("ActorAuditLogs")
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model AppModule {
  id          String           @id @default(uuid()) @db.Uuid
  key         ModuleKey        @unique
  name        String
  description String?
  isEnabled   Boolean          @default(true)
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        String    @id @default(uuid()) @db.Uuid
  roleId    String    @db.Uuid
  moduleId  String    @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  canView   Boolean   @default(false)
  canCreate Boolean   @default(false)
  canUpdate Boolean   @default(false)
  canDelete Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roleId, moduleId])
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  type        OrganizationType
  phone       String?
  address     String?
  users       User[]
  careSeekers CareSeeker[]
  cases       Case[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
}

model CareSeeker {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  fullName       String     @map("name")
  phone          String?
  displayName    String?
  phoneNumber    String?       @unique
  whatsappPhoneNumber String?  @unique
  source         CareSeekerSource @default(ADMIN)
  status         CareSeekerStatus @default(ACTIVE)
  address        String?
  riskLevel      RiskLevel     @default(MEDIUM)
  safetyNotes    String?
  cases          Case[]
  conversationSessions ConversationSession[]
  incidents      Incident[]
  evidence       Evidence[]
  caseNotes      CaseNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
}

model Case {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String?       @db.Uuid
  careSeekerId        String        @db.Uuid
  createdById         String?       @db.Uuid
  assignedToId        String?       @db.Uuid
  title               String
  summary             String?
  notes               String?
  incidentDescription String?
  status              CaseStatus    @default(OPEN)
  riskLevel           RiskLevel     @default(MEDIUM)
  confidenceScore     Float?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  careSeeker          CareSeeker    @relation(fields: [careSeekerId], references: [id])
  createdBy           User?         @relation("CaseCreatedBy", fields: [createdById], references: [id])
  assignedTo          User?         @relation("CaseAssignedTo", fields: [assignedToId], references: [id])
  evidence            Evidence[]
  caseNotes           CaseNote[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  actor       User?       @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  createdAt   DateTime    @default(now())
}

model ConversationSession {
  id            String                    @id @default(uuid()) @db.Uuid
  careSeekerId  String                    @db.Uuid
  channel       ConversationChannel
  status        ConversationSessionStatus @default(ACTIVE)
  startedAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now())
  careSeeker    CareSeeker                @relation(fields: [careSeekerId], references: [id])
  messages      ConversationMessage[]
  incidents     Incident[]
  evidence      Evidence[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([careSeekerId, channel, status])
}

model ConversationMessage {
  id          String                  @id @default(uuid()) @db.Uuid
  sessionId   String                  @db.Uuid
  direction   ConversationDirection
  messageType ConversationMessageType
  messageText String?                 @db.Text
  mediaId     String?
  evidenceId  String?                 @db.Uuid
  rawPayload  Json?
  session     ConversationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence    Evidence?               @relation(fields: [evidenceId], references: [id])
  createdAt   DateTime                @default(now())

  @@index([sessionId, createdAt])
}

model Incident {
  id                   String            @id @default(uuid()) @db.Uuid
  careSeekerId         String            @db.Uuid
  sessionId            String?           @db.Uuid
  source               IncidentSource
  title                String
  summary              String?           @db.Text
  description          String?           @db.Text
  category             IncidentCategory  @default(UNKNOWN)
  severity             IncidentSeverity  @default(UNKNOWN)
  urgency              IncidentUrgency   @default(UNKNOWN)
  incidentDateText     String?
  locationText         String?
  perpetratorRelation  String?
  riskSignals          Json?
  missingFields        Json?
  needsHumanReview     Boolean           @default(false)
  aiGenerated          Boolean           @default(false)
  aiConfidence         Decimal?          @db.Decimal(4, 3)
  confidenceScore      Float?
  caseNote             String?           @db.Text
  status               IncidentStatus    @default(DRAFT)
  manuallyEdited       Boolean           @default(false)
  careSeeker           CareSeeker        @relation(fields: [careSeekerId], references: [id])
  session              ConversationSession? @relation(fields: [sessionId], references: [id])
  evidence             Evidence[]
  caseNotes            CaseNote[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([sessionId, status])
  @@index([status, severity, urgency, source, needsHumanReview])
}

model Evidence {
  id               String              @id @default(uuid()) @db.Uuid
  careSeekerId     String              @db.Uuid
  sessionId        String?             @db.Uuid
  incidentId       String?             @db.Uuid
  caseId           String?             @db.Uuid
  source           EvidenceSource
  evidenceType     EvidenceType
  originalFileName String?
  storedFileName   String
  storagePath      String
  publicUrl        String?
  mimeType         String
  fileSize         Int
  sha256Hash       String?
  whatsappMessageId String?
  whatsappMediaId  String?
  aiAnalysisStatus EvidenceAiAnalysisStatus @default(PENDING)
  aiAnalysisJson   Json?
  aiConfidence     Float?
  aiSummary        String?             @db.Text
  caption          String?             @db.Text
  description      String?             @db.Text
  uploadedBy       EvidenceUploadedBy
  status           EvidenceStatus      @default(ACTIVE)
  careSeeker       CareSeeker          @relation(fields: [careSeekerId], references: [id])
  session          ConversationSession? @relation(fields: [sessionId], references: [id])
  incident         Incident?           @relation(fields: [incidentId], references: [id])
  case             Case?               @relation(fields: [caseId], references: [id])
  messages         ConversationMessage[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([incidentId, status])
  @@index([caseId, status])
  @@index([careSeekerId, sessionId, incidentId])
  @@index([whatsappMessageId])
}

model CaseNote {
  id            String    @id @default(uuid()) @db.Uuid
  careSeekerId  String    @db.Uuid
  incidentId    String?   @db.Uuid
  caseId        String?   @db.Uuid
  noteText      String    @db.Text
  careSeeker    CareSeeker @relation(fields: [careSeekerId], references: [id])
  incident      Incident? @relation(fields: [incidentId], references: [id])
  case          Case?     @relation(fields: [caseId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([incidentId])
  @@index([caseId])
  @@index([careSeekerId])
}
