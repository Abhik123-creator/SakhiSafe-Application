  "info": {
    "title": "SakhiSafe API",
    "description": "SakhiSafe backend API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@sakhisafe.local"
          },
          "password": {
            "type": "string",
            "example": "Admin@12345"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SUPER_ADMIN",
                "ADMIN",
                "ORGANIZATION",
                "CARE_SEEKER"
              ]
            }
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SUPER_ADMIN",
                "ADMIN",
                "ORGANIZATION",
                "CARE_SEEKER"
              ]
            }
          }
        }
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "ORGANIZATION",
              "CARE_SEEKER"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "ORGANIZATION",
              "CARE_SEEKER"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CreateModuleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "DASHBOARD",
              "USERS",
              "ROLES",
              "MODULES",
              "ORGANIZATIONS",
              "CARE_SEEKERS",
              "CASES",
              "MESSAGES",
              "INCIDENTS",
              "SAFETY_LOGS",
              "EVIDENCE",
              "RAG_DOCUMENTS",
              "AUDIT_LOGS",
              "SYSTEM_SETTINGS"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "UpdateModuleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "DASHBOARD",
              "USERS",
              "ROLES",
              "MODULES",
              "ORGANIZATIONS",
              "CARE_SEEKERS",
              "CASES",
              "MESSAGES",
              "INCIDENTS",
              "SAFETY_LOGS",
              "EVIDENCE",
              "RAG_DOCUMENTS",
              "AUDIT_LOGS",
              "SYSTEM_SETTINGS"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      },
      "RolePermissionItemDto": {
        "type": "object",
        "properties": {
          "moduleKey": {
            "type": "string",
            "enum": [
              "DASHBOARD",
              "USERS",
              "ROLES",
              "MODULES",
              "ORGANIZATIONS",
              "CARE_SEEKERS",
              "CASES",
              "MESSAGES",
              "INCIDENTS",
              "SAFETY_LOGS",
              "EVIDENCE",
              "RAG_DOCUMENTS",
              "AUDIT_LOGS",
              "SYSTEM_SETTINGS"
            ]
          },
          "canView": {
            "type": "boolean"
          },
          "canCreate": {
            "type": "boolean"
          },
          "canUpdate": {
            "type": "boolean"
          },
          "canDelete": {
            "type": "boolean"
          }
        },
        "required": [
          "moduleKey",
          "canView",
          "canCreate",
          "canUpdate",
          "canDelete"
        ]
      },
      "UpdateRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePermissionItemDto"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "NGO",
              "GOVERNMENT",
