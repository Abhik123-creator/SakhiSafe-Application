# ==============================================================================
# WhatsApp Cloud API Forwarder Config Template (.env.example)
# ==============================================================================

# ── WhatsApp / Meta ────────────────────────────────────────────────────────────
# App ID from Meta Developer Portal
APP_ID=

# App Secret from Meta Developer Portal — used to validate X-Hub-Signature-256 on inbound webhooks
APP_SECRET=

# Long-lived access token (System User or Page token)
ACCESS_TOKEN=

# WhatsApp Business Account ID (WABA ID)
WABA_ID=

# Phone Number ID from the WhatsApp Business dashboard
PHONE_NUMBER_ID=

# Arbitrary secret you define; must match the verification token in Meta App webhook config
VERIFY_TOKEN=

# Meta Graph API version (default: v25.0)
GRAPH_VERSION=v25.0

# ── Local vs Deployed ─────────────────────────────────────────────────────────
# Toggle to true to automatically resolve the public HTTPS ngrok tunnel URL
USE_NGROK=false

# Static HTTPS URL if not using ngrok (e.g. "https://forwarder.example.com")
PUBLIC_URL=

# ── Auto Configuration & Simulation ───────────────────────────────────────────
# Automatically register callback URL & verify token on startup via Meta API
AUTO_CONFIGURE_META=false

# Show typing status to sender for 25 seconds (or until a response is sent)
ENABLE_TYPING_SIMULATION=false

# Mark incoming messages as read (sends read receipt / blue checkmarks back to sender)
ENABLE_READ_RECEIPTS=false

# ── Forwarding Target ──────────────────────────────────────────────────────────
# The absolute HTTP/HTTPS URL of the downstream endpoint that consumes normalised JSON payloads.
TARGET_URL=https://your-backend.example.com/inbound

# Max seconds to wait for the downstream endpoint to respond before timing out.
TARGET_TIMEOUT_SECONDS=10

# Optional Authorization header to protect your downstream target (e.g. "Bearer token_xyz")
TARGET_AUTH_HEADER=

# ── Application ────────────────────────────────────────────────────────────────
# Uvicorn bind host
HOST=0.0.0.0

# Uvicorn bind port
PORT=8000

# Uvicorn logging level: debug | info | warning | error
LOG_LEVEL=info

# Drop incoming webhook messages older than this threshold (prevents replaying old events)
STALE_MESSAGE_THRESHOLD_SECONDS=120

# ── Telegram (Placeholder) ─────────────────────────────────────────────────────
# Toggle to enable/disable the Telegram webhook router
TELEGRAM_ENABLED=false

# Telegram Bot HTTP API Token from @BotFather
TELEGRAM_BOT_TOKEN=
