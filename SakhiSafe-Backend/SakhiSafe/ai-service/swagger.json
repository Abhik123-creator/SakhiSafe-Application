  "info": {
    "title": "SakhiSafe Internal Service API",
    "description": "Internal APIs used by Python AI service and backend service accounts.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "service-jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ServiceTokenRequestDto": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "example": "sakhi-ai-service"
          },
          "clientSecret": {
            "type": "string",
            "example": "sakhi_ai_dev_client_secret_9d7b8c6a4f2e1a0c5b3d6e8f1a2c9d0e"
          }
        },
        "required": [
          "clientId",
          "clientSecret"
        ]
      },
      "ServiceTokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 900
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "CreateCareSeekerDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "safetyNotes": {
            "type": "string"
          }
        },
        "required": [
          "fullName"
        ]
      },
      "GetOrCreateCareSeekerDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "example": "+919999999999"
          },
          "whatsappPhoneNumber": {
            "type": "string",
            "example": "+919999999999"
          },
          "displayName": {
            "type": "string",
            "example": "WhatsApp Care Seeker"
          },
          "source": {
            "type": "string",
            "enum": [
              "WHATSAPP",
              "WEB",
              "ADMIN"
            ]
          }
        }
      },
      "UpdateCareSeekerDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "safetyNotes": {
            "type": "string"
          }
        }
      },
      "CreateCaseDto": {
        "type": "object",
        "properties": {
          "careSeekerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "assignedToId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "incidentDescription": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "ESCALATED",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          }
        },
        "required": [
          "careSeekerId",
          "title"
        ]
      },
      "UpdateCaseDto": {
        "type": "object",
        "properties": {
          "careSeekerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "assignedToId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "incidentDescription": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "ESCALATED",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          }
        }
      },
      "GetOrCreateActiveSessionDto": {
        "type": "object",
        "properties": {
          "careSeekerId": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "WHATSAPP",
              "WEB"
            ]
          }
        },
        "required": [
          "careSeekerId",
          "channel"
        ]
      },
      "CreateConversationMessageDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "INBOUND",
              "OUTBOUND"
            ]
          },
          "messageType": {
            "type": "string",
            "enum": [
              "TEXT",
              "IMAGE"
            ]
          },
          "messageText": {
            "type": "string"
          },
          "mediaId": {
            "type": "string"
          },
          "evidenceId": {
            "type": "string"
          },
          "rawPayload": {
            "type": "object"
          }
        },
        "required": [
          "sessionId",
          "direction",
          "messageType",
          "messageText"
        ]
      },
      "IncidentMissingFieldsResponseDto": {
        "type": "object",
        "properties": {
          "incidentId": {
            "type": "string",
            "example": "a5e4d65c-8b51-4f6b-a6fd-5c3f27f1c7a9"
          },
          "careSeekerId": {
            "type": "string",
            "example": "89a0da54-9170-464d-bda8-bc805271d57a"
          },
          "sessionId": {
            "type": "object",
            "example": "71a96d84-6fc8-4386-9a99-38b5ee1d7953",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "example": "919999999999"
          },
          "status": {
            "type": "string",
            "example": "OPEN"
          },
          "title": {
            "type": "string",
            "example": "Reported domestic violence concern"
          },
          "missingFields": {
            "example": [
              "Current safety status",
              "Location details"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-06-05T03:30:00.000Z"
          }
        },
        "required": [
          "incidentId",
          "careSeekerId",
          "phoneNumber",
          "status",
          "title",
          "missingFields",
          "updatedAt"
        ]
      },
