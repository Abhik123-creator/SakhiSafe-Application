                  "aiAnalysisJson",
                  "aiConfidence",
                  "aiSummary"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "careSeekerPhone": {
                    "type": "string"
                  },
                  "caseId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "incidentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sessionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "whatsappMessageId": {
                    "type": "string"
                  },
                  "whatsappMediaId": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "default": "whatsapp"
                  },
                  "aiAnalysisJson": {
                    "type": "string"
                  },
                  "aiConfidence": {
                    "type": "number"
                  },
                  "aiSummary": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "survivorFriendlySummary": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "service-jwt": []
          }
        ],
        "summary": "Store image evidence and AI media observation",
        "tags": [
          "Internal Case Notes"
        ]
