APP_NAME=SakhiSafe AI Service
APP_ENV=local
APP_DEBUG=true
CORS_ORIGINS=["*"]
DATABASE_URL=postgresql+asyncpg://sakhi_user:sakhi_password@postgres:5432/sakhi_safe
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
ENABLE_LLM_SUPERVISOR=false
ENABLE_LLM_AGENT_RESPONSES=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
LLM_SUPERVISOR_TEMPERATURE=0.1
LLM_AGENT_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=700
LLM_THINKING_BUDGET=0
LLM_AGENT_MAX_CHARS=900

# Vertex AI Gemini model override
GEMINI_MODEL=gemini-1.5-flash

# Optional Anthropic/Claude-specific overrides
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Separate NestJS backend internal API integration
NEST_INTERNAL_BASE_URL=http://localhost:4000
INTERNAL_SERVICE_CLIENT_ID=sakhi-ai-service
INTERNAL_SERVICE_CLIENT_SECRET=replace_with_internal_service_client_secret
SERVICE_TOKEN_REFRESH_BUFFER_SECONDS=60
